# Copy to .env.local and fill in when ready.
# App works without DATABASE_URL (uses free open-data cache or sample leads).

# Postgres connection string (local Docker example below)
# DATABASE_URL=postgresql://estate:estate@localhost:5432/estate

# Free data pull (npm run data:pull) — no paid property APIs.
# Census ACS housing stats need a free key: https://api.census.gov/data/key_signup.html
# CENSUS_API_KEY=

# Optional later
# MAPBOX_TOKEN=
# OPENAI_API_KEY=
