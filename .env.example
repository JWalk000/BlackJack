# Environment

# App URL (Checkout success/cancel + Customer Portal return)
# Production: https://giddyup.space
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Auth + Postgres) — free tier works
# Create a project at https://supabase.com , then:
# 1. Project Settings → API → copy Project URL and anon public key
# 2. SQL Editor → paste and run supabase/schema.sql
# 3. Authentication → Providers → Email enabled (disable "Confirm email" for fastest local testing)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role — required for Stripe webhooks to update `profiles`
# (Project Settings → API → service_role). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Postgres connection string if you add a direct SQL client later
# DATABASE_URL=

# ── Stripe (Pro subscription $15/mo) ──────────────────────────────────────
# Dashboard: https://dashboard.stripe.com
# 1. Create Product "Estate Pro" (one product per plan tier)
# 2. Add recurring Price $15 USD / month → copy Price ID (price_...)
# 3. Developers → API keys → Secret key + Publishable key
# 4. Developers → Webhooks → Add endpoint
#    Production: https://giddyup.space/api/stripe/webhook
#    Events: checkout.session.completed, customer.subscription.created,
#            customer.subscription.updated, customer.subscription.deleted
# 5. Copy webhook signing secret (whsec_...)
#
# Local CLI test:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
#   # set STRIPE_WEBHOOK_SECRET to the CLI secret printed
#
# Optional sandbox without account: `stripe sandbox create` (Stripe CLI)

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_MONTHLY=
# Optional (not required for Checkout redirect flow)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
